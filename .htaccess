# Win Equipments - Apache Server Configuration & SEO Canonicalization
# Official Canonical Domain: https://winequipments.com/

<IfModule mod_rewrite.c>
    RewriteEngine On
    ErrorDocument 404 /404.html

    # 1. Enforce HTTPS and non-www canonical hostname
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.winequipments\.com$ [NC]
    RewriteRule ^(.*)$ https://winequipments.com/$1 [L,R=301]

    # 2. Critical URL & Content Mismatch Permanent Redirects (301)
    RewriteRule ^products/rounded_cooling_towers\.html$ /products/square-cooling-towers.html [R=301,L]
    RewriteRule ^locations/hosur-industrial-chillers\.html$ /locations/hosur-cnc-air-dryers.html [R=301,L]

    # 3. Product URL Harmonization (Underscores to SEO-friendly hyphens)
    RewriteRule ^products/refrigerated_air_dryers\.html$ /products/refrigerated-air-dryers.html [R=301,L]
    RewriteRule ^products/cooling_towers\.html$ /products/round-cooling-towers.html [R=301,L]
    RewriteRule ^products/chiller\.html$ /products/industrial-process-chillers.html [R=301,L]
    RewriteRule ^products/desiccant_air_dryer\.html$ /products/desiccant-air-dryers.html [R=301,L]
    RewriteRule ^products/coil_cooling\.html$ /products/closed-circuit-cooling-towers.html [R=301,L]
    RewriteRule ^products/air_receiver\.html$ /products/air-receiver-tanks.html [R=301,L]
    RewriteRule ^products/compressed_air_filter\.html$ /products/compressed-air-filters.html [R=301,L]
    RewriteRule ^products/automatic_drain_valve\.html$ /products/automatic-drain-valves.html [R=301,L]
    RewriteRule ^products/aftercooler\.html$ /products/industrial-aftercoolers.html [R=301,L]

    # 4. Catalogue & Brochure Typo Redirects
    RewriteRule ^catlogue/Automativ-Drain-valve\.pdf$ /catlogue/Automatic-Drain-Valve.pdf [R=301,L]
    RewriteRule ^catlogue/After-Coolers\.pdf$ /catlogue/E_Catalogue.pdf [R=301,L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Enable GZIP / Deflate Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Browser Caching & Expiry
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
</IfModule>

# Security: Protect server-side lead logs and data files
<FilesMatch "^leads_.*\.csv$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
