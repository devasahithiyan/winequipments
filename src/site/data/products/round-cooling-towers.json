  "faqs": [
    {
      "q": "What outlet water temperature can a WCT tower achieve?",
      "a": "Outlet water is rated at wet bulb temperature + 4 °C."
    },
    {
      "q": "Which fill should I choose?",
      "a": "L (low-temperature) fills for inlet water up to 55 °C, H (high-temperature) fills for 55–85 °C, and polypropylene rings (P) for hot or dirty water up to above 90 °C."
    },
    {
      "q": "How much water is lost to evaporation?",
      "a": "Evaporation loss ≈ 0.00085 × 1.8 × flow rate (m³/hr) × ΔT. For example, 30 m³/hr with a 5 °C range loses about 0.23 m³/hr."
    },
    {
      "q": "Where should the tower be installed?",
      "a": "Install the tower so the pump sits below the sump outlet level; never place the pump above the sump outlet."
    }
