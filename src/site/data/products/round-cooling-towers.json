  "principle": {
    "intro": "A cooling tower is a heat-rejection device that extracts waste heat from the application to the atmosphere using a fan and motor. The heat rejection is evaporative.",
    "stages": [
      {
        "name": "Distribute",
        "text": "Hot water enters the main header and is distributed through the rotary sprinkler, whose jet recoil spins it for uniform flow."
      },
      {
        "name": "Film",
        "text": "Water spreads over the honeycomb PVC fills as a film with a large contact surface."
      },
      {
        "name": "Evaporate",
        "text": "The axial fan draws air up through the fills; a small part of the water evaporates and cools the rest."
      },
      {
        "name": "Collect",
        "text": "Cooled water falls as droplets into the basin and is pumped back to the equipment."
      }
    ]
  },
