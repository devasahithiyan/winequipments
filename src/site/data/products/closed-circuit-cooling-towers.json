  "faqs": [
    {
      "q": "How is a coil cooling tower different from an FRP cooling tower?",
      "a": "In an FRP tower the water is sprayed into the air and cooled by evaporation, reaching wet bulb + 4 °C. In a WCC coil tower the water stays sealed inside finned copper tubes and is cooled by air alone, reaching ambient + 4 °C, with no water loss or contamination."
    },
    {
      "q": "Which genset sizes do WCC units suit?",
      "a": "WCC coil cooling towers cover diesel gensets from 150 to 2000 kVA."
    },
    {
      "q": "What inlet water temperature can they handle?",
      "a": "Inlet water from 75 to 90 °C at 2 to 3 bar g."
    }
  ],
