  "faqs": [
    {
      "q": "Which filter grade do I need?",
      "a": "Use GP (3 micron) as a pre-filter, ZP (0.1 micron) for general protection, ZO (0.01 micron, 0.01 mg/m³ oil) for high-quality air, and ZC (activated carbon) where oil vapour and odour must be removed."
    },
    {
      "q": "When should elements be replaced?",
      "a": "Replace the element when the differential pressure reaches 0.7 bar g."
    },
    {
      "q": "What pressure can WMF filters handle?",
      "a": "All grades are rated to a maximum operating pressure of 30 bar g and 80 °C."
    }
