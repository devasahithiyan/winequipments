    "intro": "Condensate carried with the air to end-use points is harmful if the system is not drained regularly. An automatic drain removes it without losing excessive compressed air and without shutting down the system.",
    "stages": [
      {
        "name": "Collect",
        "text": "Condensate collects at the low point of a receiver, filter, dryer or pipeline drop leg."
      },
      {
        "name": "Strain",
        "text": "A strainer-cum-manual shut-off valve protects the drain and allows isolation for service."
      },
      {
        "name": "Discharge",
        "text": "The valve opens on its timer interval, controller signal or float level and discharges the condensate at high velocity without clogging."
      }
    ]
  },
