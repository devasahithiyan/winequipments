  "principle": {
    "intro": "The chilling plant has two circuits: a refrigeration system (compressor, condenser, fan, expansion device and evaporator) and a water circulating system (pump, motor and tubing).",
    "stages": [
      {
        "name": "Water in",
        "text": "Process water returns to the chiller through the water inlet."
      },
      {
        "name": "Evaporate",
        "text": "In the brazed plate heat exchanger (evaporator) the water is cooled by the refrigerant. Counter-flow achieves the maximum temperature difference with minimum pressure drop."
      },
      {
        "name": "Reject heat",
        "text": "The refrigerant compressor sends the absorbed heat to an air- or water-cooled condenser."
      },
      {
        "name": "Water out",
        "text": "Cooled water is pumped from the closed stainless steel tank back to the process at the set temperature."
      }
    ]
  },
