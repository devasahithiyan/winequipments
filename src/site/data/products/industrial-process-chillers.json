  "faqs": [
    {
      "q": "What two values do I need to select a chiller?",
      "a": "The required water outlet (cold) temperature, and the heat load to be removed. Heat load Q = mass flow (LPM) × ΔT between inlet and outlet temperature."
    },
    {
      "q": "Are WCP chillers air cooled or water cooled?",
      "a": "Every WCP model is available with either an air-cooled or a water-cooled condenser."
    },
    {
      "q": "What is the tank made of?",
      "a": "Up to WCP 075 the tank is stainless steel. WCP 100 to WCP 200 are offered in stainless or mild steel."
    },
    {
      "q": "How does ambient temperature affect capacity?",
      "a": "Capacity is rated at 40 °C ambient. At 45 °C apply a factor of 0.9, at 50 °C 0.8."
    }
