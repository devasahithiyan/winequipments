  "principle": {
    "intro": "Air contains dust, moisture and traces of oil. Untreated wet compressed air causes equipment failures and contaminates the production process, so it must be dried before use.",
    "stages": [
      {
        "name": "Pre-cool",
        "text": "Saturated compressed air enters the pre-cooler / re-heater, where the outgoing cold air pre-cools it and reduces the heat load on the evaporator."
      },
      {
        "name": "Chill",
        "text": "In the evaporator the air is cooled further to the required dew point. The refrigerant compressor and condenser supply low-temperature refrigerant to the evaporator."
      },
      {
        "name": "Separate",
        "text": "Cooling reduces the air's capacity to hold water vapour; the moisture condenses and is removed by the water separator and automatic drain."
      },
      {
        "name": "Re-heat",
        "text": "The cold, dry air is re-heated as it passes back through the air-to-air heat exchanger before leaving the dryer."
      },
      {
        "name": "Match load",
        "text": "The thermostatic expansion valve and hot gas bypass valve match the refrigerant system to the compressed air cooling load, keeping the dew point constant."
      }
    ]
  },
