# Win Equipments: generated by src/site/build.py from src/site/htaccess.tpl and data/redirects.json. Do not edit public/.htaccess.
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTPS and non-www in one hop
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.winequipments\.com$ [NC]
    RewriteRule ^(.*)$ https://winequipments.com/$1 [L,R=301]

    # Old URLs (301)
    RewriteRule "^products/rounded_cooling_towers\.html$" /products/round-cooling-towers.html [R=301,L]
    RewriteRule "^products/refrigerated_air_dryers\.html$" /products/refrigerated-air-dryers.html [R=301,L]
    RewriteRule "^products/cooling_towers\.html$" /products/round-cooling-towers.html [R=301,L]
    RewriteRule "^products/cooling_tower\.html$" /products/round-cooling-towers.html [R=301,L]
    RewriteRule "^products/chiller\.html$" /products/industrial-process-chillers.html [R=301,L]
    RewriteRule "^products/desiccant_air_dryer\.html$" /products/desiccant-air-dryers.html [R=301,L]
    RewriteRule "^products/coil_cooling\.html$" /products/closed-circuit-cooling-towers.html [R=301,L]
    RewriteRule "^products/air_receiver\.html$" /products/air-receiver-tanks.html [R=301,L]
    RewriteRule "^products/compressed_air_filter\.html$" /products/compressed-air-filters.html [R=301,L]
    RewriteRule "^products/automatic_drain_valve\.html$" /products/automatic-drain-valves.html [R=301,L]
    RewriteRule "^products/aftercooler\.html$" /products/industrial-aftercoolers.html [R=301,L]
    RewriteRule "^locations/hosur\-industrial\-chillers\.html$" /locations/hosur-cnc-air-dryers.html [R=301,L]
    RewriteRule "^industries/laser\-cutting\.html$" /industries/automotive-cnc.html [R=301,L]
    RewriteRule "^engineering\-tools/air\-treatment\-package\-builder\.html$" /engineering-tools/ [R=301,L]
    RewriteRule "^engineering\-tools/compressed\-air\-energy\-calculator\.html$" /engineering-tools/ [R=301,L]
    RewriteRule "^installation\.html$" /about.html#installation [R=301,L,NE]
    RewriteRule "^case\-studies\.html$" /about.html [R=301,L]
    RewriteRule "^ta/$" / [R=301,L]
    RewriteRule "^E_Catalogue\.pdf$" /downloads/win-equipments-catalogue.pdf [R=301,L]
    RewriteRule "^catlogue/E_Catalogue\.pdf$" /downloads/win-equipments-catalogue.pdf [R=301,L]
    RewriteRule "^catlogue/After\-Coolers\.pdf$" /downloads/win-equipments-catalogue.pdf [R=301,L]
    RewriteRule "^catlogue/Air\-Receiver\.pdf$" /downloads/air-receiver-tanks.pdf [R=301,L]
    RewriteRule "^catlogue/Automatic\-Drain\-Valve\.pdf$" /downloads/automatic-drain-valves.pdf [R=301,L]
    RewriteRule "^catlogue/Automativ\-Drain\-valve\.pdf$" /downloads/automatic-drain-valves.pdf [R=301,L]
    RewriteRule "^catlogue/Coil cooling tower\.pdf$" /downloads/closed-circuit-cooling-towers.pdf [R=301,L]
    RewriteRule "^catlogue/Cooling\-towers\.pdf$" /downloads/frp-cooling-towers.pdf [R=301,L]
    RewriteRule "^catlogue/cooling tower\.pdf$" /downloads/frp-cooling-towers.pdf [R=301,L]
    RewriteRule "^catlogue/Desiccant air dryer\.pdf$" /downloads/desiccant-air-dryers.pdf [R=301,L]
    RewriteRule "^catlogue/Filters\.pdf$" /downloads/compressed-air-filters.pdf [R=301,L]
    RewriteRule "^catlogue/chiller\.pdf$" /downloads/industrial-process-chillers.pdf [R=301,L]
    RewriteRule "^catlogue/refrigeration air dryer\.pdf$" /downloads/refrigerated-air-dryers.pdf [R=301,L]
    RewriteRule "^catlogue/ice flake machine\.pdf$" /products/ice-flake-machines.html [R=301,L]
    RewriteRule "^catlogue/specialized chillers\.pdf$" /products/process-cooling.html [R=301,L]
    RewriteRule "^review$" https://www.google.com/maps/search/?api=1&query=Win+Equipments+Kallangadu+Nadu+Arasur+Coimbatore [R=302,L,NE]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000"
    # HTML always revalidates; versioned CSS/JS and generated images are cached for a year
    <FilesMatch "\.(html|xml)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(css|js|woff2|avif|webp|png|jpg|jpeg|svg|mp4|webm)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.pdf$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    AddType image/avif .avif
    AddType font/woff2 .woff2
    AddType video/mp4 .mp4
    AddType video/webm .webm
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Server-side files that must never be downloaded
<FilesMatch "^(secrets|chat_knowledge)\.php$|^leads_.*\.csv$|\.(md|py|yml|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
